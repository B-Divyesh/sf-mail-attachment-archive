{
  "name": "mail-attachment-archive",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --mode app",
    "build": "npm run build:site && npm run build:app",
    "build:site": "vite build --outDir dist/site",
    "build:app": "vite build --mode app --outDir dist/app",
    "tauri": "tauri",
    "test": "vitest run tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:native-claim": "node scripts/run-native-claim.mjs",
    "verify:release-identity": "node scripts/verify-release-identity.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.18.0",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
